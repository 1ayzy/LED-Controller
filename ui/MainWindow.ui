  <property name="styleSheet">
   <string notr="true">
QMainWindow, QWidget#centralwidget, QWidget#contentWidget { background-color: #0F172A; }
QWidget#titleBar { background-color: #0B1220; }
QLabel { color: #E2E8F0; font-size: 13px; }
QLabel#titleLabel { font-size: 15px; font-weight: bold; }
QLabel#DeviceNameLabel { font-size: 22px; font-weight: bold; color: #F8FAFC; }
QLabel#powerCaption, QLabel#sectionLabel { font-size: 14px; font-weight: bold; }
QLabel#StatusLabel { color: #CBD5E1; background-color: #1E293B; border-radius: 8px; padding: 10px; }
QPushButton { background-color: #1E293B; color: #F8FAFC; border: none; border-radius: 8px; padding: 10px 14px; font-size: 14px; }
QPushButton:hover { background-color: #334155; }
QPushButton:pressed { background-color: #475569; }
QPushButton#InfoButton { border-radius: 17px; font-size: 17px; font-weight: bold; padding: 0px; background-color: #1E293B; color: #93C5FD; }
QPushButton#InfoButton:hover { background-color: #3B82F6; color: #FFFFFF; }
QPushButton#ApplyColorButton { background-color: #3B82F6; color: #06152E; font-weight: bold; }
QPushButton#ApplyColorButton:hover { background-color: #2563EB; }
QPushButton#close_btn, QPushButton#minimize_btn { background-color: transparent; padding: 6px 12px; font-size: 15px; }
QPushButton#close_btn:hover { background-color: #EF4444; }
QSlider::groove:horizontal { height: 8px; background: #334155; border-radius: 4px; }
QSlider::sub-page:horizontal { background: #475569; border-radius: 4px; }
QSlider::handle:horizontal { background: #E2E8F0; width: 16px; margin: -5px 0; border-radius: 8px; }
QSlider#RSlider::handle:horizontal { background: #EF4444; }
QSlider#GSlider::handle:horizontal { background: #10B981; }
QSlider#BSlider::handle:horizontal { background: #3B82F6; }
QListWidget { background-color: #111C31; color: #E2E8F0; border: 1px solid #334155; border-radius: 8px; padding: 4px; font-size: 14px; }
QListWidget::item { padding: 8px; border-radius: 6px; }
QListWidget::item:selected { background-color: #3B82F6; color: #FFFFFF; }
QLineEdit { background-color: #1E293B; color: #F8FAFC; border: 1px solid #334155; border-radius: 8px; padding: 8px 10px; }
   </string>
