QComboBox QAbstractItemView { background-color: #1E293B; color: #F8FAFC; selection-background-color: #3B82F6; outline: none; }
QCheckBox { color: #E2E8F0; spacing: 8px; font-size: 13px; }
QListWidget { background-color: #0F172A; border: none; outline: none; }
QListWidget::item { background: transparent; border: none; padding: 0px; margin: 0px; }
QListWidget::item:hover { background: transparent; }
QListWidget::item:selected { background: transparent; color: #F8FAFC; }
QScrollBar:vertical { background: #0F172A; width: 10px; margin: 2px; border-radius: 5px; }
QScrollBar::handle:vertical { background: #334155; min-height: 36px; border-radius: 5px; }
QScrollBar::handle:vertical:hover { background: #3B82F6; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
