  <property name="styleSheet">
   <string notr="true">
QDialog, QWidget#contentWidget { background-color: #0F172A; }
QWidget#titleBar { background-color: #0B1220; }
QLabel { color: #E2E8F0; font-size: 13px; }
QLabel#titleLabel { font-size: 15px; font-weight: bold; }
QLabel#ScanStatusLabel { color: #93C5FD; background-color: #1E293B; border-radius: 6px; padding: 8px; }
QLabel#defaultMacLabel { color: #94A3B8; background-color: #1E293B; border-radius: 6px; padding: 6px; }
QPushButton { background-color: #1E293B; color: #F8FAFC; border: none; border-radius: 8px; padding: 9px 14px; font-size: 13px; }
QPushButton:hover { background-color: #334155; }
QPushButton:disabled { background-color: #172033; color: #64748B; }
QPushButton#save_btn, QPushButton#UseDeviceButton { background-color: #10B981; color: #06281D; font-weight: bold; }
QPushButton#save_btn:hover, QPushButton#UseDeviceButton:hover { background-color: #0EA271; }
QPushButton#RemoveDeviceButton { background-color: #7F1D1D; color: #FEE2E2; }
QPushButton#RemoveDeviceButton:hover { background-color: #991B1B; }
QPushButton#close_btn { background-color: transparent; padding: 6px 12px; font-size: 15px; }
QPushButton#close_btn:hover { background-color: #EF4444; }
QLineEdit, QSpinBox { background-color: #1E293B; color: #F8FAFC; border: 1px solid #334155; border-radius: 8px; padding: 7px 10px; }
QTableWidget { background-color: #111C31; color: #E2E8F0; alternate-background-color: #16233C; border: 1px solid #334155; border-radius: 8px; font-size: 12px; }
QTableWidget::item { padding: 6px; }
QTableWidget::item:selected { background-color: #3B82F6; color: #FFFFFF; }
QHeaderView::section { background-color: #1E293B; color: #94A3B8; border: none; padding: 8px; font-size: 12px; }
QCheckBox { color: #E2E8F0; spacing: 8px; font-size: 13px; }
QGroupBox { color: #94A3B8; border: 1px solid #334155; border-radius: 8px; margin-top: 14px; padding-top: 16px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; }
